# ==============================================================================
# PIPELINE AI VIDEO CONFIGURATION
# ==============================================================================

# 1. LLM API (Bước 2: Phân tích & Sinh Kịch Bản Phân Đoạn)
# Đăng ký lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Image Generation API (Bước 3: Tạo Hình Ảnh)
# Tùy chọn: pollinations | openai | imagen
IMAGE_PROVIDER=pollinations
OPENAI_API_KEY=your_openai_api_key_here

# 3. Video Generation Engine (Bước 4: Tạo Chuyển Động Video Từ Ảnh)
# Tùy chọn: motion_engine | runway | luma | svd
# Mặc định 'motion_engine': Sử dụng thuật toán Ken-Burns chuyển động máy quay (Dolly, Orbit, Tilt, Zoom) mượt mà 30fps
VIDEO_PROVIDER=motion_engine
RUNWAY_API_SECRET=your_runway_api_secret_here
LUMA_API_KEY=your_luma_api_key_here

# 4. Text-To-Speech (Bước 5: Giọng Đọc Thuyết Minh Tiếng Việt)
# Tùy chọn: edge_tts (khuyên dùng, giọng AI tự nhiên) | gtts
TTS_PROVIDER=edge_tts
# Giọng nữ: vi-VN-HoaiMyNeural | Giọng nam: vi-VN-NamMinhNeural
TTS_VOICE=vi-VN-HoaiMyNeural

# 5. Cấu hình Mạng & Cổng Chạy
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
